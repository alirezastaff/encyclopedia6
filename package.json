{
  "name": "sse-encyclopedia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "prisma generate",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "check": "npm run lint && npm run typecheck",
    "country-data": "python3 scripts/build-country-articles.py"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "d3-geo": "^3.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "^5.0.0",
    "typescript": "^5"
  }
}
